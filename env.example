# Copy to .env and fill in. Never commit .env.
# The same values must also be added by hand in Vercel → Settings → Environment Variables.

# Generate a FRESH key in Opus (left menu → Run → API → Generate API Key).
OPUS_SERVICE_KEY=your-new-service-key-here

OPUS_BASE_URL=https://operator.opus.com/api/v1
OPUS_WORKFLOW_ID=305a53b2-a030-490d-b6fa-bd331c05c72a

# Input variable ids — from the workflow's Input node
OPUS_INPUT_EMPLOYEE_RECORD=workflow_input_njojvf43i
OPUS_INPUT_RECEIPT=workflow_input_mgwnb0jd6
OPUS_INPUT_SUBMITTED_TOTAL=workflow_input_kf0w4zjdj

# Output variable ids — from the workflow's Output node
OPUS_OUTPUT_SUMMARY_REPORT=workflow_output_mca30b5t9
OPUS_OUTPUT_RECEIPT=workflow_output_b5wjhtz1l
OPUS_OUTPUT_EMPLOYEE_RECORD=workflow_output_4lotpdmad

PORT=3000

# --- Sessions ------------------------------------------------------------
# Optional but strongly recommended. Without it, session cookies are signed with
# a value that is visible in lib/auth.js and therefore forgeable.
#   openssl rand -base64 32
SESSION_SECRET=

# Optional. Grants admin to accounts beyond the built-in demo admin.
ADMIN_EMAILS=

# --- Upstash Redis (submission history) ----------------------------------
# Vercel -> Storage -> Redis -> Connect to Project sets these for you.
# Either the REST pair or REDIS_URL works; the code takes whichever exists.
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_URL=

# --- Vercel Blob (receipt copies) ----------------------------------------
BLOB_READ_WRITE_TOKEN=
